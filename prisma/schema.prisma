// BookMind — Prisma schema
// Provider: SQLite for zero-setup local development (file-based, no external DB).
// The DATABASE_URL default is `file:./dev.db`. To move to PostgreSQL for
// production, change `provider` to "postgresql", set a Postgres DATABASE_URL,
// and (optionally) reintroduce native enums / @db.Text attributes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js models
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for OAuth-only accounts
  occupation    String? // ce face utilizatorul: student, profesor, antreprenor etc.

  // Stripe subscription (Pro plan). Source of truth is Stripe; mirrored here via
  // webhook. isPro == status in {active, trialing} AND currentPeriodEnd > now.
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?
  stripePriceId            String?
  stripeSubscriptionStatus String? // active | trialing | past_due | canceled | ...
  stripeCurrentPeriodEnd   DateTime?

  accounts Account[]
  sessions Session[]
  books    Book[]
  quizzes  Quiz[]
  progress Progress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Domain models
// ---------------------------------------------------------------------------
// SQLite has no native enums. These fields hold string literals:
//   Summary.type   : "FULL" | "CHAPTER"
//   Flashcard.type : "MULTIPLE_CHOICE" | "TRUE_FALSE" | "SHORT_ANSWER"

model Book {
  id            String  @id @default(cuid())
  userId        String
  title         String
  authors       String? // comma-separated
  publishedYear String?
  description   String?
  coverUrl      String?
  externalId    String? // Google Books / Open Library volume id
  source        String  @default("google_books")

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters  Chapter[]
  summaries Summary[]
  covers    UploadedCover[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Chapter {
  id        String    @id @default(cuid())
  bookId    String
  number    Int?
  title     String?
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  summaries Summary[]

  @@index([bookId])
}

model Summary {
  id           String    @id @default(cuid())
  bookId       String
  chapterId    String?
  type         String    @default("FULL") // "FULL" | "CHAPTER"
  chapterLabel String? // e.g. "Capitolul 3" or a title, when type == CHAPTER
  content      Json // structured: { intro, sections: [{ heading, body, keyPoints[] }], conclusion, keyPoints[] }
  markedRead   Boolean   @default(false)
  markedReadAt DateTime?

  book    Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  quiz    Quiz?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId])
}

model Quiz {
  id        String @id @default(cuid())
  summaryId String @unique
  userId    String

  score       Int? // number correct
  total       Int       @default(15)
  percentage  Int? // 0..100
  completed   Boolean   @default(false)
  completedAt DateTime?
  timeSpentMs Int? // total time in ms

  summary    Summary     @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcards Flashcard[]
  answers    Answer[]
  progress   Progress?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Flashcard {
  id            String  @id @default(cuid())
  quizId        String
  order         Int
  type          String // "MULTIPLE_CHOICE" | "TRUE_FALSE" | "SHORT_ANSWER"
  question      String
  options       Json? // string[] for MULTIPLE_CHOICE
  correctAnswer String
  reference     String? // pointer to the summary section

  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([quizId])
}

model Answer {
  id          String  @id @default(cuid())
  quizId      String
  flashcardId String
  userAnswer  String
  isCorrect   Boolean
  explanation String? // AI explanation for wrong answers

  quiz      Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([quizId])
}

model Progress {
  id          String @id @default(cuid())
  userId      String
  quizId      String @unique
  score       Int
  total       Int
  percentage  Int
  timeSpentMs Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

// Reserved for the UploadThing cover-upload flow (next iteration)
model UploadedCover {
  id        String   @id @default(cuid())
  bookId    String?
  url       String
  key       String?
  createdAt DateTime @default(now())

  book Book? @relation(fields: [bookId], references: [id], onDelete: SetNull)
}
