# ---------------------------------------------------------------------------
# BookMind — environment variables
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Database. Default is zero-setup local SQLite (a file, no external service).
# Just run `npm run db:push` and you're ready.
DATABASE_URL="file:./dev.db"
#
# For production, switch prisma/schema.prisma `provider` to "postgresql" and use
# a Postgres URL instead, e.g. (Neon):
# DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/bookmind?sslmode=require"

# Auth.js secret. Generate one with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-string"

# Base URL of the app (used by Auth.js). Local dev default below.
AUTH_URL="http://localhost:3000"

# AI provider for summaries, flashcards and explanations.
#
# Recommended (FREE): Google Gemini. No credit card required.
#   1. Go to https://aistudio.google.com/apikey (sign in with your Google account)
#   2. Click "Create API key" and copy it
#   3. Paste it below as GEMINI_API_KEY
# Uses the best free model (gemini-2.5-flash) for deep, high-quality summaries.
GEMINI_API_KEY=""
#
# Optional paid alternative: Anthropic Claude. Used only if GEMINI_API_KEY is
# empty. Get one at https://console.anthropic.com/ (requires account credit).
# If BOTH are empty, the app falls back to clearly-labelled mock AI output so
# the flow still works end-to-end.
ANTHROPIC_API_KEY=""

# Optional: Google Books API key. The search works without it (unauthenticated
# quota), a key raises the rate limit.
GOOGLE_BOOKS_API_KEY=""

# ---- Payments: Stripe (Pro subscription, €5/month) -----------------------
# 1. Create a Stripe account (test mode is free) at https://dashboard.stripe.com
# 2. Products → add "BookMind Pro" with a recurring MONTHLY price of €5 →
#    copy the price id (price_...) into STRIPE_PRICE_ID.
# 3. Developers → API keys → copy the Secret key (sk_test_... in test mode).
# 4. Webhook secret: run the Stripe CLI locally:
#      stripe listen --forward-to localhost:3000/api/stripe/webhook
#    and copy the printed whsec_... into STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""

# Base URL used to build Stripe success/cancel redirects. Local dev default
# below; in production set it to your deployed URL (e.g. https://bookmind.app).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Optional / next iteration -------------------------------------------
# Google OAuth (social login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# UploadThing (manual cover upload + AI identification)
UPLOADTHING_TOKEN=""
